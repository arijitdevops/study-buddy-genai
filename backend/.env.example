# ---------------------------------------------------------------------------
# Study Buddy GenAI -- backend configuration
# Copy this file to backend/.env and fill in the values you have.
# Every key below is optional at startup: anything missing is reported by
# GET /api/health and disables just that feature.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change_me_to_a_long_random_string

# --- Google Gemini (required for any answer) -------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model ids move fast -- check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
# Used for the guardrail + routing classifiers (thinking is switched off for these).
GEMINI_GUARD_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3

# --- Database --------------------------------------------------------------
# MySQL 8 (driver: asyncmy). `docker compose up mysql` starts one that matches.
DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/study_buddy
# No MySQL handy? A local SQLite file works for trying the app out:
# DATABASE_URL=sqlite+aiosqlite:///./study_buddy.db
# Create missing tables on startup. Set to false if you manage the schema
# only with Alembic (`alembic upgrade head`).
AUTO_CREATE_TABLES=true
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Web search -------------------------------------------------------------
# Works without any key: DuckDuckGo (via the `ddgs` package) is the default.
ENABLE_WEB_SEARCH=true
# auto | duckduckgo | tavily | serper. `auto` tries Tavily, then Serper (when
# their keys are set), then DuckDuckGo.
WEB_SEARCH_PROVIDER=auto
# Optional -- https://tavily.com
TAVILY_API_KEY=
# Optional -- https://serper.dev
SERPER_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
# DuckDuckGo region, e.g. us-en, uk-en, in-en
WEB_SEARCH_REGION=us-en

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
MAX_FILES_PER_SESSION=10

# --- HTTP ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=30

# --- Pedagogy --------------------------------------------------------------
# School class 1-12 used when a session does not specify one.
DEFAULT_GRADE=8
